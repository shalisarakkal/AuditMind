# AuditMind backend configuration. Copy to backend/.env and adjust.
#
# Every setting is optional: a line left out uses the default shown here (the
# defaults live in app/core/config.py), except TEST_DATABASE_URL, which has
# none. Lists and maps are written as JSON.
#
# WHEN A CHANGE TAKES EFFECT: the backend reads this file once, when it
# starts. Saving it changes nothing until the backend is restarted (stop and
# start uvicorn; its --reload only watches code, not .env). Each setting's
# "Takes effect" line says what then changes.
# Restarting stops any import that is still running (it stays "running" and
# has to be uploaded again), so wait for imports to finish first.

# --- Application -------------------------------------------------------------

# Takes effect: after a restart (the API docs' title).
PROJECT_NAME=AuditMind AI
# Prefix of every API route. The frontend calls the API at /api/v1 on its own
# address (frontend/next.config.ts, src/lib/apiClient.ts), so keep it.
# Takes effect: after a restart; the frontend would need the same change.
API_V1_STR=/api/v1

# --- Database ----------------------------------------------------------------

# The application database (also used by Alembic migrations).
# Takes effect: after a restart (migrations: the next `alembic` command).
DATABASE_URL=postgresql+psycopg://auditmind:auditmind@localhost:5432/auditmind
# The database the tests create and drop every table in. Its name must end in
# _test: tests refuse any other database. No default: left out, the
# database tests are skipped.
# Takes effect: the next test run (no restart needed).
TEST_DATABASE_URL=postgresql+psycopg://auditmind:auditmind@localhost:5432/auditmind_test

# --- Authentication ----------------------------------------------------------

# Signs login tokens. Required: the server and the worker won't start
# without a random one of 32+ characters (the built-in default is refused).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Takes effect: after a restart; everyone is signed out and logs in again.
SECRET_KEY=
# Minutes the app's sign-in token lasts (1 to 60) before the app renews it
# with the session cookie. How long someone stays signed in is set by the
# security settings (idle time, longest sign-in), not here.
# Takes effect: after a restart, for tokens issued from then on.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT signing algorithm.
# Takes effect: after a restart; everyone is signed out and logs in again.
ALGORITHM=HS256

# --- Sign-in sessions --------------------------------------------------------

# true (the default): the session cookie is sent over HTTPS only, and
# browsers are told to use HTTPS (HSTS). Production must leave it true; this
# example sets false for local development over http://localhost.
# Takes effect: after a restart, for sign-ins from then on.
COOKIE_SECURE=false
# Sign-in attempts allowed from one address a minute, over all accounts.
# Behind a proxy, run uvicorn with --forwarded-allow-ips=<the proxy's
# address> so each person's own address is counted.
# Takes effect: after a restart.
LOGIN_RATE_LIMIT_PER_MINUTE=20
# Days a temporary password (set by an admin) can be used to sign in.
# Takes effect: after a restart, for passwords set from then on.
TEMP_PASSWORD_DAYS=7
# A session's last activity (for the idle limit) is saved at most this
# often, in seconds, rather than on every request.
# Takes effect: after a restart.
SESSION_TOUCH_SECONDS=60
# true: anyone may sign up, creating an organization of their own. false
# (the default): only the Sysadmin creates organizations and their first
# admin (create the Sysadmin with scripts/create_sysadmin.py), and each
# org's admins add its people.
# Takes effect: after a restart.
PUBLIC_SIGNUP=false

# --- Claude (AI features) ----------------------------------------------------

# Anthropic API key for the AI features (POST /ai/claude/test today). Empty:
# AI calls fail; everything else works.
# Takes effect: after a restart, from the next AI request.
ANTHROPIC_API_KEY=
# The Claude model the AI features use.
# Takes effect: after a restart, from the next AI request.
CLAUDE_MODEL=claude-sonnet-5
# Optional test-only report preview: deterministic scoring only; does not call
# an AI, embedding, or external provider. Leave false outside local verification.
# Takes effect after restarting the API.
RULE_BASED_TEST_REPORTS_ENABLED=false
# How long one Claude request may take, in seconds (each is retried twice).
CLAUDE_TIMEOUT_SECONDS=60

# --- Embeddings & RAG Knowledge Base -----------------------------------------
# Provider for 1536-dim embeddings: local_deterministic (offline dev/test),
# openai (text-embedding-3-small), or voyage.
# OPENAI_API_KEY is used by the OpenAI embeddings provider here; report
# generation currently uses Anthropic and will not switch providers from this key.
EMBEDDING_PROVIDER=local_deterministic
OPENAI_API_KEY=
VOYAGE_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small


# --- Browser access (CORS) ---------------------------------------------------

# The address(es) people open the app at, comma-separated, e.g.
# http://localhost:3000,https://auditmind.example.com. Signing in and
# renewing a session are refused from a page anywhere else (the browser's
# Origin is checked against this list), so production must list the site's
# public address. Also the addresses allowed to call the API directly.
# Takes effect: after a restart.
CORS_ORIGINS=http://localhost:3000

# --- File imports (global only) ----------------------------------------------

# Files up to this many bytes are imported during the upload (10 MB); larger
# ones run in the background, with progress shown in the app.
# Takes effect: after a restart, from the next upload.
IMPORT_SYNC_MAX_BYTES=10485760
# Files over this many bytes are rejected (1 GB): the upload size limit.
# The background worker reads a file a record at a time, never whole, so
# reading needs little memory at any size; publishing still keeps the org's
# matching assets in memory (a file of millions of rows: GBs).
# Takes effect: after a restart, from the next upload: a larger file is then
# accepted straight away (the app has no size check of its own).
IMPORT_MAX_BYTES=1073741824
# Where larger files wait for the background worker (deleted once imported).
# Relative to the backend folder. Excluded from git.
# Takes effect: after restarting the backend and the worker.
UPLOAD_DIR=uploads

# --- Background worker (python -m app.worker, or start-dev.ps1) ---------------
# A job the worker runs with no check-in for this many seconds was cut off:
# it carries on from where it got to (an import from its last staged chunk),
# up to 3 times.
# Takes effect: after restarting the worker.
WORKER_STALE_SECONDS=120
# A large upload that failed for a reason other than its content (cut off
# too often, an unexpected error) keeps its file this many days for Retry.
# Takes effect: after restarting the worker.
UPLOAD_KEEP_FAILED_DAYS=7
# How often the worker looks for new jobs when it has none (seconds).
# Takes effect: after restarting the worker.
WORKER_POLL_SECONDS=2
# The daily auto-purge goes after uploads and jobs people start, but once a
# purge has waited this many minutes it takes its turn by age like the rest.
# Takes effect: after restarting the worker.
AUTO_PURGE_MAX_WAIT_MINUTES=60

# --- Ingestion defaults ------------------------------------------------------
# Each organization can override these in Settings > Ingestion; an override
# wins over the value here.
# Takes effect (all of them): after a restart, from the next import, for
# organizations that haven't overridden the setting. Data already imported is
# not changed; an import that's running keeps the values it started with.
# (An organization's own override applies from its next import, no restart.)

# true: import the valid rows and report the bad ones.
# false: any bad row rejects the whole file.
IMPORT_PARTIAL_SUCCESS=true
# An imported asset that matches an existing one (by cloud ID, else hostname
# and category, else IP): update | skip | duplicate
ASSET_EXISTING_STRATEGY=update
# Nessus "Info" items (severity 0): skip | low (record them as low)
NESSUS_INFO_SEVERITY=skip
# Extra Nessus plugin family -> domain mappings, merged over the built-in map.
# Domains: identity_access, network_config, vulnerability_management,
# backup_recovery, monitoring_detection, incident_response, compliance_alignment
# e.g. NESSUS_DOMAIN_MAP={"Web Servers": "network_config", "Databases": "vulnerability_management"}
NESSUS_DOMAIN_MAP={}
# Domain for Nessus plugin families with no mapping.
NESSUS_DEFAULT_DOMAIN=vulnerability_management
# Extra asset type names -> category, merged over the built-in list (laptop,
# VM, Lambda, bucket...). Categories: server, workstation, network_device,
# database, cloud_resource, application. Names match ignoring case, spaces,
# '-' and '_' (LoadBalancer = load balancer).
# e.g. ASSET_TYPE_ALIASES={"hypervisor": "server", "nas": "cloud_resource"}
ASSET_TYPE_ALIASES={}

# --- Archiving -----------------------------------------------------------------
# Days an archived upload, asset or finding is kept before it's purged for
# good. Each organization can override it in Settings > Ingestion.
# Takes effect: after a restart, for organizations without an override; the
# countdown on the Archived page and the next daily purge both use it,
# including for items archived before the change.
ARCHIVE_RETENTION_DAYS=180
# Archive, restore and purge jobs up to this many rows run during the request;
# larger ones run in the background, shown in the import tracker.
# Takes effect: after a restart, from the next archive, restore or purge.
ARCHIVE_SYNC_MAX_ROWS=20000
# true: the background worker purges archived items and Activity events past
# their retention, a minute after it starts and then once a day. false:
# schedule scripts/purge_expired.py with Task Scheduler or cron instead.
# Takes effect: after restarting the worker.
ARCHIVE_AUTO_PURGE=true

# --- Activity (the event log) --------------------------------------------------
# Days Activity events are kept. Each organization can override it in
# Settings > Ingestion.
# Takes effect: the worker's next daily clean-up, for organizations without
# an override.
EVENT_RETENTION_DAYS=365
# An organization with more events than this has its oldest Info events,
# then its oldest failed sign-ins, deleted early (other Warning events and
# Critical ones are always kept), and its admins see a warning in Activity.
# Takes effect: the worker's next daily clean-up.
EVENT_SAFETY_NET_ROWS=1000000

# AuditMind backend configuration. Copy to backend/.env and adjust.
#
# Every setting is optional: a line left out uses the default shown here (the
# defaults live in app/core/config.py), except TEST_DATABASE_URL, which has
# none. Lists and maps are written as JSON.
#
# WHEN A CHANGE TAKES EFFECT: the backend reads this file once, when it
# starts. Saving it changes nothing until the backend is restarted (stop and
# start uvicorn; its --reload only watches code, not .env). Each setting's
# "Takes effect" line says what then changes.
# Restarting stops any import that is still running (it stays "running" and
# has to be uploaded again), so wait for imports to finish first.

# --- Application -------------------------------------------------------------

# Takes effect: after a restart (the API docs' title).
PROJECT_NAME=AuditMind AI
# Prefix of every API route. The frontend's NEXT_PUBLIC_API_URL must end with it.
# Takes effect: after a restart; change the frontend's address at the same time.
API_V1_STR=/api/v1

# --- Database ----------------------------------------------------------------

# The application database (also used by Alembic migrations).
# Takes effect: after a restart (migrations: the next `alembic` command).
DATABASE_URL=postgresql+psycopg://auditmind:auditmind@localhost:5432/auditmind
# The database the tests create and drop every table in. Its name must end in
# _test: tests refuse any other database. No default: left out, the
# database tests are skipped.
# Takes effect: the next test run (no restart needed).
TEST_DATABASE_URL=postgresql+psycopg://auditmind:auditmind@localhost:5432/auditmind_test

# --- Authentication ----------------------------------------------------------

# Signs login tokens. Use a long random value outside local development, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Takes effect: after a restart; everyone is signed out and logs in again.
SECRET_KEY=change-me-to-a-random-secret
# How long a login lasts, in minutes (1440 = 24 hours).
# Takes effect: after a restart, for logins made from then on (existing
# logins keep the length they were given).
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT signing algorithm.
# Takes effect: after a restart; everyone is signed out and logs in again.
ALGORITHM=HS256

# --- Claude (AI features) ----------------------------------------------------

# Anthropic API key for the AI features (POST /ai/claude/test today). Empty:
# AI calls fail; everything else works.
# Takes effect: after a restart, from the next AI request.
ANTHROPIC_API_KEY=
# The Claude model the AI features use.
# Takes effect: after a restart, from the next AI request.
CLAUDE_MODEL=claude-sonnet-5

# --- Browser access (CORS) ---------------------------------------------------

# The frontend's address(es) allowed to call the API, comma-separated,
# e.g. http://localhost:3000,https://auditmind.example.com
# Takes effect: after a restart.
CORS_ORIGINS=http://localhost:3000

# --- File imports (global only) ----------------------------------------------

# Files up to this many bytes are imported during the upload (10 MB); larger
# ones run in the background, with progress shown in the app.
# Takes effect: after a restart, from the next upload.
IMPORT_SYNC_MAX_BYTES=10485760
# Files over this many bytes are rejected (100 MB). An import holds the whole
# file in memory while it reads and checks it, peaking at roughly 25x the file
# size (a 100 MB file: ~2.5 GB), so raise it only with memory to spare.
# Takes effect: after a restart, from the next upload: a larger file is then
# accepted straight away (the app has no size check of its own).
IMPORT_MAX_BYTES=104857600

# --- Ingestion defaults ------------------------------------------------------
# Each organization can override these in Settings > Ingestion; an override
# wins over the value here.
# Takes effect (all of them): after a restart, from the next import, for
# organizations that haven't overridden the setting. Data already imported is
# not changed; an import that's running keeps the values it started with.
# (An organization's own override applies from its next import, no restart.)

# true: import the valid rows and report the bad ones.
# false: any bad row rejects the whole file.
IMPORT_PARTIAL_SUCCESS=true
# An imported asset that matches an existing one (by cloud ID, else hostname
# and category, else IP): update | skip | duplicate
ASSET_EXISTING_STRATEGY=update
# Nessus "Info" items (severity 0): skip | low (record them as low)
NESSUS_INFO_SEVERITY=skip
# Extra Nessus plugin family -> domain mappings, merged over the built-in map.
# Domains: identity_access, network_config, vulnerability_management,
# backup_recovery, monitoring_detection, incident_response, compliance_alignment
# e.g. NESSUS_DOMAIN_MAP={"Web Servers": "network_config", "Databases": "vulnerability_management"}
NESSUS_DOMAIN_MAP={}
# Domain for Nessus plugin families with no mapping.
NESSUS_DEFAULT_DOMAIN=vulnerability_management
# Extra asset type names -> category, merged over the built-in list (laptop,
# VM, Lambda, bucket...). Categories: server, workstation, network_device,
# database, cloud_resource, application. Names match ignoring case, spaces,
# '-' and '_' (LoadBalancer = load balancer).
# e.g. ASSET_TYPE_ALIASES={"hypervisor": "server", "nas": "cloud_resource"}
ASSET_TYPE_ALIASES={}

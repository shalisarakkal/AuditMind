# AuditMind frontend configuration. Copy to frontend/.env.local and adjust
# (.env.local is git-ignored). A line left out uses the default shown here.
#
# WHEN A CHANGE TAKES EFFECT: NEXT_PUBLIC_ values are built into the page
# code. In development, restart `npm run dev`; in production, rebuild
# (`npm run build`) and restart. Then reload the app in the browser (Ctrl+F5).
# They are visible to anyone using the app, so never put secrets here.

# The backend API's base address, ending with the backend's API_V1_STR
# (/api/v1). The browser calls it directly, so the backend's CORS_ORIGINS
# must include this frontend's address.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
